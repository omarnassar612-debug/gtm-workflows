-- Leads created in a period. Run both queries and combine the results.
-- COQL excludes converted leads by default, so one query alone undercounts.
-- Replace the dates. Use your own timezone offset.

-- 1) Unconverted leads
select id, Lead_Status, Created_Time, Disqualification_Reason
from Leads
where Created_Time between '2026-06-01T00:00:00-04:00' and '2026-06-30T23:59:59-04:00'
  and Converted__s = false
limit 200;

-- 2) Converted leads (explicit filter required)
select id, Lead_Status, Created_Time
from Leads
where Created_Time between '2026-06-01T00:00:00-04:00' and '2026-06-30T23:59:59-04:00'
  and Converted__s = true
limit 200;

-- Then:
--   total = rows(1) + rows(2)
--   qualified = total minus leads whose Disqualification_Reason contains
--               the contractor / mystery-shopper value
-- Disqualification_Reason is an array field. Filter on it after fetching.
-- If results truncate, split the window (days 1-15, days 16-30) and offset by 200.
