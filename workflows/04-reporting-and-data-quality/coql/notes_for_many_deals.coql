-- Notes for many deals in one call.
-- IN (...) on Parent_Id works. OR chains in the WHERE clause did not work for Notes.

select Parent_Id, Note_Title, Note_Content, Created_Time
from Notes
where Parent_Id in ('DEAL_ID_1','DEAL_ID_2','DEAL_ID_3')
limit 200;

